---
import { Link } from 'accessible-astro-components'
import SimpleAnalyticsBadge from './SimpleAnalyticsBadge.astro'
import WebsiteCarbonBadge from './WebsiteCarbonBadge.astro'

const currentYear = new Date().getFullYear()
---

<footer>
  <section class="py-8">
    <!-- three rows on wide screens: copyright | legal links, design | analytics credit, carbon credit -->
    <div class="footer__content container">
      <p class="footer__copyright">
        Copyright &copy; 2025-{currentYear}
        <Link href="https://proswimworkouts.com/" isExternal>
          ProSwimWorkouts
        </Link>
      </p>
      <nav class="footer__nav" aria-label="About and legal">
        <ul class="footer__links">
          <li>
            <a href="/about">About</a>
          </li>
          <li>
            <a href="/privacy">Privacy policy</a>
          </li>
          <li>
            <a href="/terms">Terms of service</a>
          </li>
        </ul>
      </nav>
      <p class="footer__design">
        Design and development by
        <Link href="https://cutting-edge.dev/" isExternal>
          Cutting Edge Development Studio
        </Link>
      </p>
      <div class="footer__analytics">
        <SimpleAnalyticsBadge />
      </div>
      <div class="footer__carbon">
        <WebsiteCarbonBadge />
      </div>
    </div>
  </section>
</footer>

<style lang="scss">
  @use 'scss/base/breakpoint' as *;

  // The lane-rope stripe above the footer (src/assets/scss/base/_swim.scss) replaces the border
  footer {
    --lane-gap: var(--surface-color);

    background-color: var(--surface-color);
    color: var(--text-muted-color);
    font-size: 1rem; // a step under the 18px body text, as in the mockup
  }

  // one column on phones, in reading order; from 768px two columns, each right-hand item
  // on the same row as its left-hand partner, and the carbon credit alone on the last row
  .footer__content {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: var(--space-xs) var(--space-l);

    p {
      margin: 0;
    }

    @include breakpoint(m) {
      grid-template-columns: 1fr auto;

      .footer__nav,
      .footer__analytics {
        justify-self: end;
      }

      .footer__carbon {
        grid-column: 1 / -1;
      }
    }
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
