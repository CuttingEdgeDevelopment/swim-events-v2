---
import { Link } from 'accessible-astro-components'
import SimpleAnalyticsBadge from './SimpleAnalyticsBadge.astro'

const currentYear = new Date().getFullYear()
---

<footer>
  <section class="py-8">
    <div class="footer__content container">
      <p>
        Copyright &copy; 2025-{currentYear}
        <Link href="https://cutting-edge.dev/" isExternal>Cutting Edge Development Studio</Link>
        <span class="ms-1">by Nicolas Messer</span>
      </p>
      <div class="footer__end">
        <nav aria-label="Legal">
          <ul class="footer__links">
            <li><a href="/privacy">Privacy policy</a></li>
            <li><a href="/terms">Terms of service</a></li>
          </ul>
        </nav>
        <SimpleAnalyticsBadge />
      </div>
    </div>
  </section>
</footer>

<style lang="scss">
  // The lane-rope stripe above the footer (src/assets/scss/base/_swim.scss) replaces the border
  footer {
    --lane-gap: var(--surface-color);

    background-color: var(--surface-color);
    color: var(--text-muted-color);
    font-size: 1rem; // a step under the 18px body text, as in the mockup
  }

  // copyright on the left, legal links and the analytics badge on the right, stacked on narrow screens
  .footer__content {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-xs) var(--space-l);

    p {
      margin: 0;
    }
  }

  .footer__end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-l);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
