---
import { Link } from 'accessible-astro-components'

const currentYear = new Date().getFullYear()
---

<footer>
  <section class="py-8">
    <div class="container">
      <p>
        Copyright &copy; 2025-{currentYear}
        <Link href="https://cutting-edge.dev/" isExternal>Cutting Edge Development Studio</Link>
        <span class="ms-1">by Nicolas Messer</span>
      </p>
    </div>
  </section>
</footer>

<style lang="scss">
  // The lane-rope stripe above the footer (src/assets/scss/base/_swim.scss) replaces the border
  footer {
    --lane-gap: var(--surface-color);

    background-color: var(--surface-color);
    color: var(--text-muted-color);
    font-size: 1rem; // a step under the 18px body text, as in the mockup
  }
</style>
