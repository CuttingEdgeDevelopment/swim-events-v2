---
import { Link } from 'accessible-astro-components'
import SimpleAnalyticsBadge from './SimpleAnalyticsBadge.astro'
import WebsiteCarbonBadge from './WebsiteCarbonBadge.astro'

const currentYear = new Date().getFullYear()
---

<footer>
  <section class="py-8">
    <div class="footer__content container">
      <div class="footer__owner">
        <p>
          Copyright &copy; 2025-{currentYear}
          <Link href="https://proswimworkouts.com/" isExternal>
            ProSwimWorkouts
          </Link>
        </p>
        <p>
          Design and development by
          <Link href="https://cutting-edge.dev/" isExternal>
            Cutting Edge Development Studio
          </Link>
        </p>
      </div>
      <nav aria-label="About and legal">
        <ul class="footer__links">
          <li>
            <a href="/about">About</a>
          </li>
          <li>
            <a href="/privacy">Privacy policy</a>
          </li>
          <li>
            <a href="/terms">Terms of service</a>
          </li>
        </ul>
      </nav>
      <div class="footer__credit">
        <SimpleAnalyticsBadge />
        <WebsiteCarbonBadge />
      </div>
    </div>
  </section>
</footer>

<style lang="scss">
  // The lane-rope stripe above the footer (src/assets/scss/base/_swim.scss) replaces the border
  footer {
    --lane-gap: var(--surface-color);

    background-color: var(--surface-color);
    color: var(--text-muted-color);
    font-size: 1rem; // a step under the 18px body text, as in the mockup
  }

  // copyright on the left, legal links on the right, analytics and carbon credits on their own row below
  .footer__content {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-xs) var(--space-l);

    p {
      margin: 0;
    }
  }

  .footer__owner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  // side by side when they fit, stacked on narrow screens
  .footer__credit {
    display: flex;
    flex-basis: 100%;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-l);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
