---
import { Icon } from 'astro-icon/components'

/**
 * EventCardTemplate Component
 *
 * @description An HTML <template> for one event card. Events are loaded in the browser,
 * so `src/scripts/events.ts` clones and fills this template for each event.
 */
---

<template id="event-card-template">
  <li class="event-card">
    <div class="event-card__info">
      <h3 class="event-card__name text-xl font-semibold">
        <span data-field="name"></span>
        {/* eslint-disable-next-line astro/jsx-a11y/anchor-is-valid -- href is set by src/scripts/events.ts */}
        <a data-field="link" target="_blank" rel="noopener noreferrer" hidden>
          <Icon aria-hidden="true" name="lucide:external-link" size="1.25rem" />
          <span class="sr-only">Event website (opens in new tab)</span>
        </a>
      </h3>
      <dl class="event-card__details">
        <div><dt>Location</dt> <dd data-field="location"></dd></div>
        <div><dt data-field="start-label">Begins</dt> <dd data-field="start"></dd></div>
        <div><dt data-field="end-label">Ends</dt> <dd data-field="end"></dd></div>
      </dl>
    </div>
    <div class="event-card__countdown">
      <span data-icon="ongoing" hidden><Icon aria-hidden="true" name="lucide:flame" size="4rem" /></span>
      <span data-icon="today" hidden><Icon aria-hidden="true" name="lucide:rocket" size="4rem" /></span>
      <p class="event-card__number" data-field="number" hidden></p>
      <p class="font-bold" data-field="label"></p>
    </div>
  </li>
</template>

<style lang="scss" is:global>
  .event-list {
    display: flex;
    flex-direction: column;
    align-self: stretch;
    gap: var(--space-s);
    margin-block-start: var(--space-m);
    padding: 0;
    inline-size: 100%;
    list-style: none;
  }

  .event-card {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-m);
    border: 1px solid var(--foreground-color);
    border-radius: var(--radius-l);
    padding: var(--space-m);

    &.is-live {
      border-width: 3px;
    }
  }

  .event-card__name {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-end: var(--space-2xs);

    a {
      display: inline-flex;
      color: var(--link-color);
    }
  }

  .event-card__details {
    margin: 0;

    dt,
    dd {
      display: inline;
    }

    dt {
      font-weight: 600;

      &::after {
        content: ': ';
      }
    }

    dd {
      margin: 0;
    }
  }

  .event-card__countdown {
    min-inline-size: 10rem;
    text-align: center;

    span[data-icon] {
      display: flex;
      justify-content: center;
    }

    span[data-icon][hidden] {
      display: none;
    }

    [data-icon='ongoing'] {
      color: light-dark(#b91c1c, #f87171);
    }

    [data-icon='today'] {
      color: light-dark(#15803d, #4ade80);
    }
  }

  .event-card__number {
    font-size: 4.5rem;
    line-height: 1;
  }
</style>
