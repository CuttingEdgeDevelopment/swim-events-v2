---
/**
 * EventCardTemplate Component
 *
 * @description An HTML <template> for one event card in the event lists. Events are
 * loaded in the browser, so `src/scripts/events.ts` clones and fills this template.
 */
---

<template id="event-card-template">
  <li class="event-card">
    <div class="event-card__info">
      <h3 class="event-card__name">
        <span data-field="name"></span>
        {/* eslint-disable-next-line astro/jsx-a11y/anchor-is-valid -- href is set by src/scripts/events.ts */}
        <a class="event-link" data-field="link" target="_blank" rel="noopener noreferrer" hidden></a>
      </h3>
      <p class="event-card__meta">
        <span data-field="place"></span><span class="event-card__sep" aria-hidden="true"> · </span><span
          class="event-card__dates"
          data-field="dates"></span>
      </p>
    </div>
    <span class="badge badge--info event-card__badge" data-field="badge" hidden></span>
    <p class="event-card__countdown" data-field="countdown">
      <span class="event-card__number" data-field="number"></span>
      <span class="event-card__unit" data-field="unit"></span>
    </p>
  </li>
</template>

<style lang="scss" is:global>
  @use '../assets/scss/base/breakpoint' as *;

  .event-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    inline-size: 100%;
    list-style: none;
  }

  .event-card {
    display: grid;
    grid-template-areas:
      'countdown badge'
      'info info';
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-2xs) var(--space-m);
    border: 1px solid var(--border-subtle-color);
    border-radius: var(--radius-h);
    background-color: var(--surface-color);
    padding: var(--space-s) var(--space-m);

    @include breakpoint(m) {
      grid-template-areas: 'info badge countdown';
      grid-template-columns: 1fr auto auto;
    }
  }

  .event-card__info {
    grid-area: info;
    min-inline-size: 0;
  }

  .event-card__name {
    font-size: var(--font-size-1);
    line-height: 1.3;
  }

  .event-card__meta {
    color: var(--text-muted-color);
  }

  // Place and dates on separate lines on small screens, one line from tablet up
  .event-card__sep {
    display: none;

    @include breakpoint(m) {
      display: inline;
    }
  }

  .event-card__dates {
    display: block;

    @include breakpoint(m) {
      display: inline;
    }
  }

  .event-card__badge {
    grid-area: badge;
    justify-self: end;
  }

  .event-card__countdown {
    grid-area: countdown;
    line-height: 1.1;

    @include breakpoint(m) {
      min-inline-size: 8rem;
      text-align: end;
    }
  }

  .event-card__number {
    color: var(--pool-color);
    font-weight: 700;
    font-size: var(--font-size-5);
    font-variant-numeric: tabular-nums;

    @include breakpoint(m) {
      display: block;
      font-size: var(--font-size-6);
    }
  }

  .event-card__unit {
    color: var(--text-muted-color);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    border: 1px solid transparent;
    border-radius: 999px;
    padding: var(--space-4xs) var(--space-xs);
    font-weight: 700;
    font-size: var(--font-size--1);
    white-space: nowrap;

    &[hidden] {
      display: none;
    }
  }

  .badge--info {
    background-color: var(--badge-info-bg);
    color: var(--badge-info-text);
  }

  .badge--live {
    background-color: var(--badge-live-bg);
    color: var(--badge-live-text);
  }
</style>
