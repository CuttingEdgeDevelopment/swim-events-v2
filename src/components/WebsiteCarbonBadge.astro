---
// Website Carbon credit (https://gitlab.com/wholegrain/website-carbon-badges): the CO2 per page
// view of the site, measured on the home page, from the Website Carbon API. Written for this site instead of embedding the official
// b.min.js, which uses fixed ids, runs once (so it would stop after the first View Transition)
// and loads from unpkg. Like the official badge it caches the result on the visitor's device,
// so a visitor asks at most once a day, and once an hour after a failed answer.
//
// To keep it light and private:
// - it measures only https://swim-events.com/, one figure for the whole site, so no page path is sent
// - it calls the API only in production, and only when the footer comes near the screen
// - it stays hidden until it has a figure (no "measuring" placeholder that flashes up and
//   disappears when the API fails), and without JavaScript
// Styled like the Simple Analytics text credit next to it, in the footer's text colour, so it
// follows the light and dark theme on its own.
---

<a
  class="wc-credit"
  href="https://www.websitecarbon.com/website/swim-events-com/"
  target="_blank"
  rel="noopener"
  data-website-carbon
  hidden
>
  <span class="wc-credit__caption" data-field="wc-result">
    CO₂ per page view
  </span>
  <span class="wc-credit__byline">
    by Website Carbon<span class="sr-only"> (opens in new tab)</span>
  </span>
</a>

<script>
  const API = 'https://api.websitecarbon.com/b?url='
  const HOME = 'https://swim-events.com/'
  const KEY = `wcb_${HOME}`
  const FAILED_KEY = 'wcb_failed'
  const HOUR = 60 * 60 * 1000
  const DAY = 24 * HOUR

  type Result = { c: number; p: number; t: number }

  const grams = new Intl.NumberFormat('en', { maximumFractionDigits: 2 })

  const read = (key: string): Result | null => {
    try {
      const saved = JSON.parse(localStorage.getItem(key) ?? 'null')
      return saved && Number.isFinite(saved.c) && Number.isFinite(saved.p) && Number.isFinite(saved.t) ? saved : null
    } catch {
      return null
    }
  }

  const save = (key: string, result: Result) => {
    try {
      localStorage.setItem(key, JSON.stringify(result))
    } catch {
      // private mode or full storage: the badge still shows, it just asks again next time
    }
  }

  const show = (badge: HTMLElement, { c, p }: Result) => {
    const text = badge.querySelector('[data-field="wc-result"]')
    if (text)
      text.textContent = `${grams.format(c)} g of CO₂ per page view, cleaner than ${Math.round(p)}% of pages tested`
    badge.hidden = false
  }

  // after a failed answer, wait an hour before asking again instead of asking on every page
  const failedRecently = () => {
    try {
      return Date.now() - Number(localStorage.getItem(FAILED_KEY) ?? 0) < HOUR
    } catch {
      return false
    }
  }

  const noteFailure = () => {
    try {
      localStorage.setItem(FAILED_KEY, String(Date.now()))
    } catch {
      // nothing to remember it in: the next page simply asks again
    }
  }

  const measure = async (badge: HTMLElement) => {
    try {
      const response = await fetch(API + encodeURIComponent(HOME), { referrerPolicy: 'no-referrer' })
      if (!response.ok) throw new Error(`Website Carbon answered ${response.status}`)
      const { c, p } = await response.json()
      if (!Number.isFinite(c) || !Number.isFinite(p)) throw new Error('Website Carbon sent no result')
      const result = { c, p, t: Date.now() }
      save(KEY, result)
      if (badge.isConnected) show(badge, result)
    } catch {
      // keep yesterday's figure if there is one, otherwise stay hidden
      noteFailure()
    }
  }

  let observer: IntersectionObserver | undefined

  const initWebsiteCarbon = () => {
    observer?.disconnect()
    const badge = document.querySelector<HTMLElement>('[data-website-carbon]')
    if (!badge || !import.meta.env.PROD || !('fetch' in window)) return

    const cached = read(KEY)

    if (cached) show(badge, cached)
    if ((cached && Date.now() - cached.t < DAY) || failedRecently()) return

    // wait until the visitor scrolls near the footer, so most page views make no call at all
    observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return
        observer?.disconnect()
        measure(badge)
      },
      { rootMargin: '200px 0px' },
    )
    observer.observe(badge.closest('footer') ?? badge)
  }

  document.addEventListener('astro:page-load', initWebsiteCarbon)
</script>

<style lang="scss" is:global>
  // the same text-link look as the Simple Analytics credit (SimpleAnalyticsBadge.astro)
  footer a.wc-credit {
    display: block;
    color: inherit;
    line-height: 1.6;
    text-decoration: none;

    &[hidden] {
      display: none;
    }

    &:hover .wc-credit__byline {
      text-decoration: underline;
    }

    &:focus-visible {
      outline: 3px solid var(--outline-color);
      outline-offset: 2px;
      box-shadow: 0 0 0 2px var(--focus-halo);
    }
  }

  // compressHTML drops the space between the two spans, so the caption brings its own
  footer .wc-credit__caption::after {
    content: ' ';
  }

  footer .wc-credit__byline {
    white-space: nowrap;
  }
</style>
