---
import DefaultLayout from '@layouts/DefaultLayout.astro'

interface Props {
  /**
   * The page heading, also used as the page title
   */
  title: string
  /**
   * The description for search engines and social sharing
   */
  description: string
  /**
   * When the text last changed materially, as YYYY-MM-DD
   */
  updated: string
}

const { title, description, updated } = Astro.props

const updatedLabel = new Date(`${updated}T00:00:00Z`).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
})
---

<DefaultLayout title={title} description={description}>
  <article class="legal">
    <div class="container">
      <div class="legal__text space-content">
        <h1 class="legal__title">{title}</h1>
        <p class="legal__updated">Last updated <time datetime={updated}>{updatedLabel}</time></p>
        <slot />
      </div>
    </div>
  </article>
</DefaultLayout>

<style lang="scss">
  .legal {
    padding-block: var(--space-l) var(--space-xl);
  }

  // one readable column, as on the submit form
  .legal__text {
    max-inline-size: 42rem;

    :global(h2) {
      font-size: var(--font-size-2);
      line-height: 1.25;
    }

    :global(h3) {
      font-size: var(--font-size-1);
      line-height: 1.3;
    }

    :global(ul) {
      padding-inline-start: 1.25em;
      list-style: disc;
    }

    :global(li + li) {
      margin-block-start: var(--space-2xs);
    }

    :global(address) {
      font-style: normal;
    }
  }

  .legal__title {
    font-size: var(--font-size-4);
    line-height: 1.15;
  }

  .legal__updated {
    color: var(--text-muted-color);
  }
</style>
