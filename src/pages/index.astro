---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import EventCardTemplate from '@components/EventCardTemplate.astro'
import { Icon } from 'astro-icon/components'
import { Button, Heading, Notification, Tabs, TabsList, TabsPanel, TabsTab } from 'accessible-astro-components'
---

<DefaultLayout title="Swim Events Countdown" useTitleTemplate={false}>
  <section class="mt-8 mb-12">
    <div class="space-content container">
      <Heading level="h1">Swim Events Countdown</Heading>
      <div id="today" hidden>
        <p class="text-xl font-semibold">Happy <span data-field="weekday"></span>!</p>
        <p class="italic">Current date: <span data-field="date"></span></p>
      </div>
    </div>
  </section>

  <section class="mb-16" aria-labelledby="events-heading">
    <div class="container">
      <h2 id="events-heading" class="sr-only">Events</h2>

      <noscript>
        <Notification type="warning">
          <p>This page needs JavaScript to load the events and calculate the countdowns.</p>
        </Notification>
      </noscript>

      <div class="events-toolbar">
        <p id="events-status" role="status" class="events-status" data-state="loading">
          <span data-field="text">Loading events</span><span class="loading-dots" aria-hidden="true"
            ><span>.</span><span>.</span><span>.</span></span
          >
        </p>
        <Button id="refresh-events" size="sm" variant="outlined" animateOnHover animationType="rotate">
          <Icon aria-hidden="true" name="lucide:refresh-cw" size="1.25rem" />
          Update events
        </Button>
      </div>

      <Tabs>
        <TabsList aria-label="Events">
          <TabsTab id="upcoming-tab" controls="upcoming-panel" selected>Upcoming events</TabsTab>
          <TabsTab id="past-tab" controls="past-panel">Past events</TabsTab>
        </TabsList>
        <TabsPanel id="upcoming-panel" labelledby="upcoming-tab" selected>
          <ul id="upcoming-events" class="event-list"></ul>
          <p class="event-list-empty" hidden>No upcoming events.</p>
        </TabsPanel>
        <TabsPanel id="past-panel" labelledby="past-tab">
          <ul id="past-events" class="event-list"></ul>
          <p class="event-list-empty" hidden>No past events.</p>
        </TabsPanel>
      </Tabs>
    </div>
  </section>

  <EventCardTemplate />
</DefaultLayout>

<script>
  import { initEvents } from '../scripts/events'

  document.addEventListener('astro:page-load', initEvents)
</script>

<style lang="scss">
  .events-toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-s);
    margin-block-end: var(--space-m);
  }

  .events-status {
    font-style: italic;

    &[data-state='error'] {
      color: light-dark(#b91c1c, #f87171);
      font-style: normal;
      font-weight: 700;
    }

    &:not([data-state='loading']) .loading-dots {
      display: none;
    }
  }

  .loading-dots span {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .loading-dots span {
      animation: loading-dot 1s infinite;
    }

    .loading-dots span:nth-child(2) {
      animation-delay: 0.15s;
    }

    .loading-dots span:nth-child(3) {
      animation-delay: 0.3s;
    }
  }

  @keyframes loading-dot {
    0%,
    100% {
      translate: 0 0;
    }

    50% {
      translate: 0 -0.25em;
    }
  }
</style>
